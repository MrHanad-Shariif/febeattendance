# Local development settings. Copy to `.env` and adjust. Never commit the real .env file.
# (Production is configured through the repo-root .env.production.example / docker-compose.yml.)

APP_ENV=development
# APP_TIMEZONE=Africa/Mogadishu     # required in production; on Windows set the OS time zone instead

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://febe_user:febe_password@localhost:5432/febe_attendance

# Flask / JWT. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-a-different-long-random-string
JWT_EXPIRES_HOURS=8

# Frontend origin allowed to call the API (comma separated for multiple)
FRONTEND_ORIGIN=http://localhost:5173
# Base URL of the frontend, used inside emails (invite / reset password links)
FRONTEND_BASE_URL=http://localhost:5173
# Public URLs of the check-in pages, used to generate the printable QR codes
CHECKIN_URL=http://localhost:5173/checkin
STUDENT_CHECKIN_URL=http://localhost:5173/student-checkin

# Number of reverse proxies in front of the API (0 for local dev)
TRUSTED_PROXY_COUNT=0

# Rotating kiosk code. Generate a secret with: python -c "import pyotp; print(pyotp.random_base32())"
KIOSK_TOTP_SECRET=CHANGEMECHANGEMECHANGEMECHANGEME
KIOSK_CODE_INTERVAL_SECONDS=60
KIOSK_CODE_DIGITS=6
# Random string embedded in the kiosk screen's URL (?key=...). python -c "import secrets; print(secrets.token_urlsafe(24))"
KIOSK_ACCESS_KEY=change-this-kiosk-access-key

# Student class-code (shown on the lecturer's own laptop with the session's QR code; unique per class session)
STUDENT_CODE_TOTP_SECRET=CHANGEMESTUDENTCHANGEMESTUDENT1
STUDENT_CODE_INTERVAL_SECONDS=20
STUDENT_CODE_DIGITS=6

# Folder holding the face models (face_detection_yunet_2023mar.onnx, face_recognition_sface_2021dec.onnx)
# FACE_MODEL_DIR=./models

# Outgoing email (invites, verification, password reset). Leave MAIL_USERNAME empty to log emails instead of sending.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# First super-admin, created by `flask seed-admin`
DEFAULT_ADMIN_NAME=Faculty Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

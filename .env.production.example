# Production settings for docker-compose.yml. Copy to `.env` on the server and fill in.
# Generate all the random values at once with:  python3 deploy/generate_env.py > .env
# NEVER commit the real .env file.

# Public hostname (DNS A record must point at the server). No scheme, no slash.
DOMAIN=febeattendance.mansok.com

# Campus time zone (IANA name). Class times are compared in this zone.
APP_TIMEZONE=Africa/Mogadishu

# Database password (the app connects as user febe_user)
POSTGRES_PASSWORD=

# Long random secrets (>= 32 chars). Rotating SECRET_KEY/JWT_SECRET_KEY signs everyone out.
SECRET_KEY=
JWT_SECRET_KEY=
KIOSK_TOTP_SECRET=
KIOSK_ACCESS_KEY=
STUDENT_CODE_TOTP_SECRET=

# First admin account, created automatically on first start. Change the password after signing in.
DEFAULT_ADMIN_NAME=Faculty Admin
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Outgoing email (invites, verification, password reset, reminders).
# Gmail needs an "app password": https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
